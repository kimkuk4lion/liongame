generator client {
  provider               = "prisma-client"
  output                 = "../server/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "mts"
  importFileExtension    = "mts"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id       BigInt          @id @default(autoincrement())
  kakaoId  String          @unique(map: "lion_members_kakao_id_key") @map("kakao_id")
  nickname String
  sessions LoginSession[]
  results  MatchResult[]

  @@map("lion_members")
}

model LoginSession {
  tokenHash String   @id @map("token_hash")
  memberId  BigInt   @map("member_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lion_sessions_member_id_fkey")

  @@map("lion_sessions")
}

model MatchResult {
  roundId  String @id @map("round_id") @db.Uuid
  memberId BigInt @map("member_id")
  mode     String
  score    Int
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lion_results_member_id_fkey")

  @@index([mode, memberId], map: "lion_results_mode_member")
  @@map("lion_results")
}
